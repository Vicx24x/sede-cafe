# Copia este archivo como ".env" y cambia los valores.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgres://sedecafe:cambia_esta_contrasena@localhost:5432/sede_cafe"

# Clave para firmar los tokens JWT. Usa una cadena larga y aleatoria.
# En Linux puedes generarla con:  openssl rand -hex 32
JWT_SECRET="cambia_esta_clave_por_una_larga_y_aleatoria"
JWT_EXPIRES_IN="8h"

# Puerto donde escucha el servidor Express
PORT=3000

# development | production  (en production Express también sirve el frontend compilado)
NODE_ENV=development

# Origen permitido para CORS en desarrollo (servidor de Vite)
CORS_ORIGIN="http://localhost:5173"
